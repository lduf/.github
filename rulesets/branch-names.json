{
  "name": "branch-names",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": "__APP_ID__", "actor_type": "Integration", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/feat/**",
        "refs/heads/fix/**",
        "refs/heads/perf/**",
        "refs/heads/refactor/**",
        "refs/heads/docs/**",
        "refs/heads/test/**",
        "refs/heads/build/**",
        "refs/heads/ci/**",
        "refs/heads/chore/**",
        "refs/heads/style/**",
        "refs/heads/revert/**",
        "refs/heads/revert-*",
        "refs/heads/release/**",
        "refs/heads/claude/**",
        "refs/heads/copilot/**",
        "refs/heads/renovate/**",
        "refs/heads/dependabot/**",
        "refs/heads/ktisis/**"
      ]
    }
  },
  "rules": [
    { "type": "creation" }
  ]
}
